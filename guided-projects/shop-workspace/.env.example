# Set variables in the server terminal; this file is a template, not auto-loaded.
AI_MODE=offline
# For a real provider experiment, explicitly choose models supported by your account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Production additionally needs HTTPS/proxy configuration and explicit origins/hosts.
APP_ENV=local
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
