const __vite_ssr_export_default__ = /* #__PURE__ */ JSON.parse("[\n  {\n    \"id\": 1,\n    \"scene\": \"A repair shop needs a page that helps a visitor decide whether to contact it.\",\n    \"comparisons\": [\n      {\n        \"title\": \"A greeting or a useful message?\",\n        \"before\": { \"heading\": \"Welcome.\" },\n        \"change\": { \"heading\": \"Repairs near you.\" },\n        \"notice\": \"Read the page as someone looking for a repair. Which heading gives you useful information?\",\n        \"takeaway\": \"The browser displays the words you supply. A useful result starts with the visitor's need, even when AI writes the page.\"\n      },\n      {\n        \"title\": \"A different shop\",\n        \"before\": { \"heading\": \"Repairs near you.\" },\n        \"change\": { \"heading\": \"Bicycle repairs near you.\" },\n        \"notice\": \"Only the heading changes. The page still opens and its Contact action still works.\",\n        \"takeaway\": \"A change in the business can require different content without requiring a new database or a live AI call.\"\n      }\n    ]\n  },\n  {\n    \"id\": 2,\n    \"scene\": \"The shop owner dislikes the page, but “make it impressive” leaves the builder guessing.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Turn a feeling into a check\",\n        \"before\": { \"direction\": \"Make it impressive.\", \"scope\": \"one\" },\n        \"change\": {\n          \"direction\": \"Put opening hours below Services. Check that the hours are visible on a phone.\"\n        },\n        \"notice\": \"Look for a named part, an action and an observation someone can check.\",\n        \"takeaway\": \"Concrete direction gives a builder something to act on. This tiny word checker illustrates that pattern; it does not evaluate arbitrary instructions.\"\n      },\n      {\n        \"title\": \"Keep the change small\",\n        \"before\": {\n          \"direction\": \"Put opening hours below Services. Check that the hours are visible on a phone.\",\n          \"scope\": \"all\"\n        },\n        \"change\": { \"scope\": \"one\" },\n        \"notice\": \"Keep the words identical. Change how much of the site the builder may alter.\",\n        \"takeaway\": \"A bounded change leaves unrelated decisions outside the task. Actual AI output still needs to be inspected.\"\n      }\n    ]\n  },\n  {\n    \"id\": 3,\n    \"scene\": \"The shop wants a bigger heading. That is a different request from changing its words or its button's action.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Appearance changes, words stay\",\n        \"before\": { \"size\": 26, \"heading\": \"Repairs near you.\", \"rule\": true },\n        \"change\": { \"size\": 38 },\n        \"notice\": \"Watch the heading grow. Read its words again; they have not changed.\",\n        \"takeaway\": \"Presentation and content have different jobs. Changing the CSS size need not change the HTML content.\"\n      },\n      {\n        \"title\": \"A button can look ready and do nothing\",\n        \"before\": { \"size\": 26, \"heading\": \"Repairs near you.\", \"rule\": true },\n        \"change\": { \"rule\": false },\n        \"notice\": \"Try Contact in both cases. Compare its appearance with what actually happens.\",\n        \"takeaway\": \"A visible button does not prove that an action rule is present. Behaviour needs its own check.\"\n      }\n    ]\n  },\n  {\n    \"id\": 4,\n    \"scene\": \"A visitor wants an estimate. The shop must decide which quantities are allowed before calculating a total.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Blank is different from zero\",\n        \"before\": { \"quantity\": \"0\", \"price\": 25 },\n        \"change\": { \"quantity\": \"\" },\n        \"notice\": \"Compare a zero total with a withheld total. Those results mean different things.\",\n        \"takeaway\": \"Zero is an allowed quantity in this rule. Blank means the visitor has not supplied an allowed quantity, so the model withholds the total.\"\n      },\n      {\n        \"title\": \"One more item\",\n        \"before\": { \"quantity\": \"2\", \"price\": 25 },\n        \"change\": { \"quantity\": \"3\" },\n        \"notice\": \"Count the item chips. One additional item adds one more unit price to the receipt.\",\n        \"takeaway\": \"The same multiplication rule works for each allowed whole quantity: quantity times price per item.\"\n      }\n    ]\n  },\n  {\n    \"id\": 5,\n    \"scene\": \"The shop adds services. The page should create a card for each record using one display rule.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Grow the collection\",\n        \"before\": { \"count\": 3, \"duplicate\": false, \"prefix\": \"Repair\" },\n        \"change\": { \"count\": 6 },\n        \"notice\": \"Count the records and cards. The display rule stays the same as the collection grows.\",\n        \"takeaway\": \"A loop applies the same rule to each record. More records do not require a separately written card for each one.\"\n      },\n      {\n        \"title\": \"Different cards, repeated identity\",\n        \"before\": { \"count\": 3, \"duplicate\": false },\n        \"change\": { \"duplicate\": true },\n        \"notice\": \"Inspect the cards marked Repeated ID. Their display labels cannot repair their repeated identifier.\",\n        \"takeaway\": \"Names and labels describe records. Stable, distinct identifiers let the system tell those records apart.\"\n      }\n    ]\n  },\n  {\n    \"id\": 6,\n    \"scene\": \"The owner says customers miss visits. Before building a reminder, you need to know what supports that claim.\",\n    \"comparisons\": [\n      {\n        \"title\": \"An example or an observation?\",\n        \"before\": { \"source\": \"invented\", \"sample\": 10, \"missed\": 2 },\n        \"change\": { \"source\": \"records\" },\n        \"notice\": \"The numbers stay identical. Inspect how the source changes what can be said about them.\",\n        \"takeaway\": \"An invented example shows a possibility. Checked fictional records describe this model sample, but still do not identify the cause of missed visits.\"\n      },\n      {\n        \"title\": \"Can the counts fit?\",\n        \"before\": { \"source\": \"records\", \"sample\": 10, \"missed\": 2 },\n        \"change\": { \"sample\": 1 },\n        \"notice\": \"Try fitting two missed visits inside a sample containing only one visit.\",\n        \"takeaway\": \"Conflicting counts need investigation before calculating or interpreting a rate. A precise-looking percentage cannot repair inconsistent inputs.\"\n      }\n    ]\n  },\n  {\n    \"id\": 7,\n    \"scene\": \"Two missed visits sound small, but the meaning depends on how many eligible visits there were.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Keep the count; change the whole\",\n        \"before\": { \"eligible\": \"10\", \"missed\": 2 },\n        \"change\": { \"eligible\": \"100\" },\n        \"notice\": \"The missed count stays at two. Watch the fraction and percentage change.\",\n        \"takeaway\": \"Two out of ten is 20%; two out of one hundred is 2%. The denominator changes the meaning of the same count.\"\n      },\n      {\n        \"title\": \"Unknown is not zero percent\",\n        \"before\": { \"eligible\": \"10\", \"missed\": 2 },\n        \"change\": { \"eligible\": \"\" },\n        \"notice\": \"Remove the eligible total. Look for Unknown rather than a reassuring zero.\",\n        \"takeaway\": \"A rate needs a usable denominator. Missing information should remain visible instead of silently becoming a favourable result.\"\n      }\n    ]\n  },\n  {\n    \"id\": 8,\n    \"scene\": \"A customer is trying to request a visit. The form must help them recover when input or connectivity is missing.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Give the form its required input\",\n        \"before\": { \"visit\": \"\", \"connected\": true },\n        \"change\": { \"visit\": \"V-42\" },\n        \"notice\": \"Follow the draft, connection and result steps before and after an identifier is present.\",\n        \"takeaway\": \"Required input is checked before the request proceeds in this model. A real confirmation still needs a real service response.\"\n      },\n      {\n        \"title\": \"Keep the draft when the connection fails\",\n        \"before\": { \"visit\": \"V-42\", \"connected\": true },\n        \"change\": { \"connected\": false },\n        \"notice\": \"Read the draft after the connection fails. It should still contain V-42.\",\n        \"takeaway\": \"Keeping useful input and explaining the failure helps a person recover. A lost connection must not turn into an invented confirmation.\"\n      }\n    ]\n  },\n  {\n    \"id\": 9,\n    \"scene\": \"The shop is choosing between a package and a custom build. Compare the same period and required capabilities.\",\n    \"comparisons\": [\n      {\n        \"title\": \"A repeating fee accumulates\",\n        \"before\": { \"months\": 1, \"license\": 20, \"setup\": 120, \"build\": 600 },\n        \"change\": { \"months\": 24 },\n        \"notice\": \"Compare the growing package line with the fixed stated build cost.\",\n        \"takeaway\": \"The package's stated total reaches 600 units after two years in this example. This arithmetic excludes maintenance and other costs.\"\n      },\n      {\n        \"title\": \"A cheaper option can miss the need\",\n        \"before\": { \"months\": 1, \"needExport\": false, \"vendorExport\": false },\n        \"change\": { \"needExport\": true },\n        \"notice\": \"The totals stay the same. The package now lacks a capability the shop requires.\",\n        \"takeaway\": \"A lower price does not supply a missing requirement. Capability, omitted costs and risks belong in the decision too.\"\n      }\n    ]\n  },\n  {\n    \"id\": 10,\n    \"scene\": \"The interface says Saved, but the shop needs to know whether the intended visit actually changed.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Inspect more than the toast\",\n        \"before\": { \"check\": \"toast\", \"defect\": true, \"selected\": \"V-42\" },\n        \"change\": { \"check\": \"records\" },\n        \"notice\": \"Keep the defect. Compare the message-only check with a check of both records.\",\n        \"takeaway\": \"The same defect can hide behind a passing toast check. A useful assertion inspects the intended change and the state that must stay unchanged.\"\n      },\n      {\n        \"title\": \"Correct the updater\",\n        \"before\": { \"check\": \"records\", \"defect\": true, \"selected\": \"V-42\" },\n        \"change\": { \"defect\": false },\n        \"notice\": \"Watch which record becomes confirmed. The other record should remain pending.\",\n        \"takeaway\": \"A relevant check should distinguish the faulty updater from the corrected one. A success message alone cannot do that.\"\n      }\n    ]\n  },\n  {\n    \"id\": 11,\n    \"scene\": \"A customer submits a visit request. What should the browser say if it stops waiting before the response arrives?\",\n    \"comparisons\": [\n      {\n        \"title\": \"The response arrives too late\",\n        \"before\": { \"latency\": 800, \"timeout\": 1000, \"valid\": true },\n        \"change\": { \"latency\": 1800 },\n        \"notice\": \"Compare the response delay with the client's waiting limit.\",\n        \"takeaway\": \"A timeout means the client stopped waiting. It does not establish whether the server stopped or whether a write happened.\"\n      },\n      {\n        \"title\": \"Give the client time to receive the response\",\n        \"before\": { \"latency\": 1800, \"timeout\": 1000, \"valid\": true },\n        \"change\": { \"timeout\": 2000 },\n        \"notice\": \"Keep the server timing fixed and change only the waiting limit.\",\n        \"takeaway\": \"The response can now arrive within the model's waiting period. Real retries still need stable identity and evidence of the final state.\"\n      }\n    ]\n  },\n  {\n    \"id\": 12,\n    \"scene\": \"Two customers are named Alex. After a restart, the shop also needs its records to remain available.\",\n    \"comparisons\": [\n      {\n        \"title\": \"A separate storage lifetime\",\n        \"before\": { \"restart\": true, \"storage\": \"memory\", \"lookup\": \"Alex\" },\n        \"change\": { \"storage\": \"persistent\" },\n        \"notice\": \"Compare the retained records after the same process restart.\",\n        \"takeaway\": \"Process memory and persistent storage have different lifetimes. Persistence still needs its own protection, backup and recovery.\"\n      },\n      {\n        \"title\": \"One name, two identities\",\n        \"before\": { \"restart\": true, \"storage\": \"persistent\", \"lookup\": \"Alex\" },\n        \"change\": { \"lookup\": \"V-42\" },\n        \"notice\": \"Compare two name matches with one exact identifier match.\",\n        \"takeaway\": \"A person's name may not uniquely select a record. A stable identifier can target the intended visit.\"\n      }\n    ]\n  },\n  {\n    \"id\": 13,\n    \"scene\": \"Two booking operations compete for the last slot. Retries can also repeat a single intended operation.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Protect the last slot\",\n        \"before\": { \"slots\": 1, \"requests\": 2, \"atomic\": false, \"retries\": 0, \"sameKey\": false },\n        \"change\": { \"atomic\": true },\n        \"notice\": \"Inspect each operation's result. Accepted bookings must not exceed capacity.\",\n        \"takeaway\": \"A capacity check and reservation need a protected operation. Separate unprotected checks can both act on the same available slot.\"\n      },\n      {\n        \"title\": \"A retry is not a new intention\",\n        \"before\": { \"slots\": 4, \"requests\": 1, \"atomic\": true, \"retries\": 3, \"sameKey\": false },\n        \"change\": { \"sameKey\": true },\n        \"notice\": \"Keep four attempts. Change whether they share one operation identifier.\",\n        \"takeaway\": \"Stable retry identity lets repeated attempts refer to one intended operation instead of creating several reservations in this model.\"\n      }\n    ]\n  },\n  {\n    \"id\": 14,\n    \"scene\": \"Customer C7 is signed in. That does not automatically allow access to C8's private visit.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Signed in, different owner\",\n        \"before\": { \"caller\": \"C7\", \"owner\": \"C7\", \"serverCheck\": true },\n        \"change\": { \"owner\": \"C8\" },\n        \"notice\": \"The requesting identity stays signed in while the record owner changes.\",\n        \"takeaway\": \"Authentication identifies the caller. Authorization separately decides whether that caller may access this record.\"\n      },\n      {\n        \"title\": \"Remove the trusted check\",\n        \"before\": { \"caller\": \"C7\", \"owner\": \"C8\", \"serverCheck\": true },\n        \"change\": { \"serverCheck\": false },\n        \"notice\": \"Inspect whether a refused record becomes returned without permission.\",\n        \"takeaway\": \"A sign-in badge or hidden button cannot enforce the trusted record boundary. Removing the check can leak the fictional record.\"\n      }\n    ]\n  },\n  {\n    \"id\": 15,\n    \"scene\": \"The shop wants to send a reminder through a provider. Configuration, acceptance and delivery are different facts.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Configure before attempting\",\n        \"before\": { \"credential\": false, \"provider\": \"accepted\", \"retries\": 0 },\n        \"change\": { \"credential\": true },\n        \"notice\": \"Compare zero provider attempts with an acknowledged attempt. No secret value is requested.\",\n        \"takeaway\": \"Required configuration permits an attempt in this model. Provider acceptance still does not establish delivery to a person.\"\n      },\n      {\n        \"title\": \"A timeout leaves uncertainty\",\n        \"before\": { \"credential\": true, \"provider\": \"accepted\", \"retries\": 0 },\n        \"change\": { \"provider\": \"unknown\" },\n        \"notice\": \"Read the acceptance and delivery evidence separately after the response becomes ambiguous.\",\n        \"takeaway\": \"An ambiguous response is not a known failure or a verified delivery. A real system needs reconciliation rather than an invented success count.\"\n      }\n    ]\n  },\n  {\n    \"id\": 16,\n    \"scene\": \"An executor is given a task, some authority and a budget. Each boundary has its own job.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Enough budget to finish\",\n        \"before\": { \"budget\": 2, \"demand\": 3, \"permission\": \"test\", \"request\": \"test\" },\n        \"change\": { \"budget\": 4 },\n        \"notice\": \"Count the operations that run and the units that remain.\",\n        \"takeaway\": \"A permitted task can still stop at its budget. Increasing the budget makes this three-operation model task affordable.\"\n      },\n      {\n        \"title\": \"Money does not grant permission\",\n        \"before\": { \"budget\": 10, \"demand\": 3, \"permission\": \"test\", \"request\": \"test\" },\n        \"change\": { \"request\": \"live\" },\n        \"notice\": \"Keep ample budget. Ask for an action outside the granted test authority.\",\n        \"takeaway\": \"The authority check refuses the action before spending budget. Extra resources do not expand permission.\"\n      }\n    ]\n  },\n  {\n    \"id\": 17,\n    \"scene\": \"Two workstreams are building connected parts. They need a shared interface as well as time to coordinate.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Agree on the field\",\n        \"before\": { \"uiField\": \"status\", \"serverField\": \"accessStatus\" },\n        \"change\": { \"uiField\": \"accessStatus\" },\n        \"notice\": \"Compare the key the interface expects with the key in the supplied payload.\",\n        \"takeaway\": \"Compatible field names let this local interface check fit. Speed elsewhere cannot repair a broken agreement between parts.\"\n      },\n      {\n        \"title\": \"More workers, one small task\",\n        \"before\": {\n          \"uiField\": \"accessStatus\",\n          \"serverField\": \"accessStatus\",\n          \"workers\": 1,\n          \"tasks\": 1,\n          \"minutes\": 5\n        },\n        \"change\": { \"workers\": 6 },\n        \"notice\": \"Look for idle workers and additional coordination time.\",\n        \"takeaway\": \"One five-minute task still needs one work round. Extra workers add coordination in this model, so the total increases rather than decreases.\"\n      }\n    ]\n  },\n  {\n    \"id\": 18,\n    \"scene\": \"An example response contains a neat date field, but the source never supplied a date.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Keep an unknown fact unknown\",\n        \"before\": {\n          \"output\": \"{\\\"summary\\\":\\\"Customer called about a repair.\\\",\\\"date\\\":\\\"2026-10-20\\\"}\",\n          \"sourceDate\": \"\"\n        },\n        \"change\": { \"output\": \"{\\\"summary\\\":\\\"Customer called about a repair.\\\",\\\"date\\\":null}\" },\n        \"notice\": \"The JSON can parse in both cases. Inspect the separate check for date support.\",\n        \"takeaway\": \"A valid shape does not establish a fact. Null can represent an unknown date without inventing certainty.\"\n      },\n      {\n        \"title\": \"Support must come from a source\",\n        \"before\": {\n          \"output\": \"{\\\"summary\\\":\\\"Customer called about a repair.\\\",\\\"date\\\":\\\"2026-10-20\\\"}\",\n          \"sourceDate\": \"\"\n        },\n        \"change\": { \"sourceDate\": \"2026-10-20\" },\n        \"notice\": \"Keep the response identical. Supply the matching date as fictional source evidence.\",\n        \"takeaway\": \"The source changes what the date check can support. This small rule still does not verify every claim in the summary or evaluate a real AI model.\"\n      }\n    ]\n  },\n  {\n    \"id\": 19,\n    \"scene\": \"A helper retrieves a cancellation policy. A matching topic is only the beginning of checking whether it is usable.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Relevant but too old\",\n        \"before\": { \"age\": 20, \"maxAge\": 7, \"docAction\": false, \"authority\": false },\n        \"change\": { \"age\": 2 },\n        \"notice\": \"Keep the question fixed. Compare the document age with the allowed age.\",\n        \"takeaway\": \"Relevance and freshness answer different questions. This fictional policy now fits the model's age rule.\"\n      },\n      {\n        \"title\": \"An instruction inside a document\",\n        \"before\": { \"age\": 2, \"maxAge\": 7, \"docAction\": false, \"authority\": false },\n        \"change\": { \"docAction\": true },\n        \"notice\": \"The source now asks to cancel the visit, but separate action authority is still absent.\",\n        \"takeaway\": \"Retrieved text supplies information. It cannot grant the user and policy authority required for an action.\"\n      }\n    ]\n  },\n  {\n    \"id\": 20,\n    \"scene\": \"The helper flags urgent messages. The shop needs to inspect both false alerts and missed urgent cases.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Raise the threshold\",\n        \"before\": { \"threshold\": 30, \"positives\": 10, \"negatives\": 90 },\n        \"change\": { \"threshold\": 70 },\n        \"notice\": \"Inspect the same labelled cases before and after the threshold changes.\",\n        \"takeaway\": \"A threshold can reduce alerts while increasing missed positive cases. Precision and recall describe different parts of that tradeoff.\"\n      },\n      {\n        \"title\": \"Change the case mix\",\n        \"before\": { \"threshold\": 70, \"positives\": 10, \"negatives\": 90 },\n        \"change\": { \"positives\": 50 },\n        \"notice\": \"Keep the decision threshold. Add fictional positive cases to the evaluation sample.\",\n        \"takeaway\": \"The sample composition affects aggregate results. Record the labels, sample definition and mistakes that matter instead of quoting a metric without context.\"\n      }\n    ]\n  },\n  {\n    \"id\": 21,\n    \"scene\": \"A regression check needs to notice a wrong-record update, including when the selected visit changes.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Does the assertion see the defect?\",\n        \"before\": { \"check\": \"toast\", \"defect\": true, \"selected\": \"V-42\" },\n        \"change\": { \"check\": \"records\" },\n        \"notice\": \"Keep the updater faulty. Change the evidence the assertion inspects.\",\n        \"takeaway\": \"A passing weak check is not evidence that the relevant behaviour works. The record assertion exposes the deliberately faulty updater.\"\n      },\n      {\n        \"title\": \"Select the other record\",\n        \"before\": { \"check\": \"records\", \"defect\": true, \"selected\": \"V-42\" },\n        \"change\": { \"selected\": \"V-43\" },\n        \"notice\": \"The intended record changes. Does the assertion still identify the incorrect update?\",\n        \"takeaway\": \"A check should follow the selected record and protect the other one, rather than hard-coding one convenient identifier.\"\n      }\n    ]\n  },\n  {\n    \"id\": 22,\n    \"scene\": \"A release changes code, configuration and possibly stored information. Those parts do not roll back together automatically.\",\n    \"comparisons\": [\n      {\n        \"title\": \"A release needs its configuration\",\n        \"before\": { \"credential\": false, \"build\": true, \"migration\": false, \"rollback\": false },\n        \"change\": { \"credential\": true },\n        \"notice\": \"The build passes in both cases. Inspect whether the required configuration is also present.\",\n        \"takeaway\": \"A passing build is one release condition. The running journey also needs its declared configuration and compatible data.\"\n      },\n      {\n        \"title\": \"Rollback only the code\",\n        \"before\": { \"credential\": true, \"build\": true, \"migration\": true, \"rollback\": false },\n        \"change\": { \"rollback\": true },\n        \"notice\": \"Watch code change from v2 to v1 while the data schema remains v2.\",\n        \"takeaway\": \"Reverting code does not restore stored data. Under these declared rules, old code cannot read the migrated schema.\"\n      }\n    ]\n  },\n  {\n    \"id\": 23,\n    \"scene\": \"A visit request feels slow. A trace helps you locate time before choosing what to change.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Shorten one measured span\",\n        \"before\": { \"provider\": 1900, \"database\": 80, \"validation\": 20, \"inspect\": \"provider\" },\n        \"change\": { \"provider\": 100 },\n        \"notice\": \"Keep database and validation time fixed. Watch the total and provider bar shrink.\",\n        \"takeaway\": \"A controlled change to one span changes this sequential total. A real incident still needs new observations to verify a proposed fix.\"\n      },\n      {\n        \"title\": \"Move the bottleneck\",\n        \"before\": { \"provider\": 100, \"database\": 80, \"validation\": 20, \"inspect\": \"database\" },\n        \"change\": { \"database\": 1000 },\n        \"notice\": \"Look for the longest measured step after the database duration increases.\",\n        \"takeaway\": \"The relevant investigation can change with the evidence. A familiar explanation should not replace inspection of the current trace.\"\n      }\n    ]\n  },\n  {\n    \"id\": 24,\n    \"scene\": \"The shop repeats the same read. Reuse can reduce source work, but the freshness rule affects what people receive.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Refresh once, then reuse\",\n        \"before\": { \"mode\": \"fresh\", \"reads\": 20, \"age\": 15, \"ttl\": 10, \"changed\": true },\n        \"change\": { \"mode\": \"cache\" },\n        \"notice\": \"The cached copy starts expired. Inspect the first source read and the later cache hits.\",\n        \"takeaway\": \"For these same-key, same-instant requests, the first read refreshes the copy and later reads reuse it. This is a model, not a service benchmark.\"\n      },\n      {\n        \"title\": \"Within its lifetime, already stale\",\n        \"before\": { \"mode\": \"cache\", \"reads\": 20, \"age\": 15, \"ttl\": 10, \"changed\": true },\n        \"change\": { \"age\": 2 },\n        \"notice\": \"The copy now passes the age rule even though the source changed after it was stored.\",\n        \"takeaway\": \"A cache lifetime is a reuse policy, not proof that a copy equals the current source. The model now returns stale cached answers.\"\n      }\n    ]\n  },\n  {\n    \"id\": 25,\n    \"scene\": \"A change removed visit records. Having a snapshot, restoring it and checking the result are separate steps.\",\n    \"comparisons\": [\n      {\n        \"title\": \"Restore the snapshot\",\n        \"before\": { \"restore\": false, \"count\": 4, \"dropped\": 2, \"backup\": true, \"verify\": false },\n        \"change\": { \"restore\": true },\n        \"notice\": \"Compare the expected identifiers with the records after the chosen recovery.\",\n        \"takeaway\": \"A snapshot can supply the missing records in this local model. The restore label alone is still weaker than querying the recovered state.\"\n      },\n      {\n        \"title\": \"Check the recovered identifiers\",\n        \"before\": { \"restore\": true, \"count\": 4, \"dropped\": 2, \"backup\": true, \"verify\": false },\n        \"change\": { \"verify\": true },\n        \"notice\": \"The records stay present. Inspect the difference between an unrun check and com