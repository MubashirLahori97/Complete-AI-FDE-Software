    solutionCode: `import math

def chunk_text(text: str, chunk_size: int = 50, overlap: int = 10) -> list:
    if not text:
        return []
    step = max(1, chunk_size - overlap)
    chunks = []
    for i in range(0, len(text), step):
        chunk = text[i:i + chunk_size]
        if chunk:
            chunks.append(chunk)
        if i + chunk_size >= len(text):
            break
    return chunks

def cosine_similarity(u: list, v: list) -> float:
    if len(u) != len(v) or len(u) == 0:
        return 0.0
    dot_product = sum(a * b for a, b in zip(u, v))
    norm_u = math.sqrt(sum(a * a for a in u))
    norm_v = math.sqrt(sum(b * b for b in v))
    if norm_u == 0.0 or norm_v == 0.0:
        return 0.0
    return dot_product / (norm_u * norm_v)

class SimpleVectorStore:
    def __init__(self):
        self.documents = []

    def add_document(self, doc_id: str, embedding: list, text: str):
        self.documents.append({
            "doc_id": doc_id,
            "embedding": embedding,
            "text": text
        })

    def search(self, query_embedding: list, top_k: int = 2) -> list:
        scored = []
        for doc in self.documents:
            score = cosine_similarity(query_embedding, doc["embedding"])
            scored.append({
                "doc_id": doc["doc_id"],
                "text": doc["text"],
                "score": round(score, 4)
            })
        scored.sort(key=lambda x: x["score"], reverse=True)
        return scored[:top_k]
