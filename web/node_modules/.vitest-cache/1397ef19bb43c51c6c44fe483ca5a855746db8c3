const __vite_ssr_export_default__ = /* #__PURE__ */ JSON.parse("[\n  {\n    \"id\": 1,\n    \"title\": \"Give a visitor something useful.\",\n    \"idea\": \"Your browser turns page instructions into a visible website. A useful heading tells a visitor what you do. Changing those words happens in this browser; it does not require a database or a live AI call.\",\n    \"task\": \"Replace Welcome with a heading that tells a visitor what the shop does.\",\n    \"first\": \"Give it a useful heading\",\n    \"try\": { \"heading\": \"Repairs near you.\" },\n    \"boundary\": \"The page runs real HTML, CSS and JavaScript. Its shop and contact details are fictional; no messages are sent.\",\n    \"challenge\": \"Keep the heading useful when the shop changes from appliance repairs to bicycle repairs.\",\n    \"controls\": [\n      { \"id\": \"heading\", \"label\": \"The page heading\", \"type\": \"text\", \"default\": \"Welcome.\" },\n      {\n        \"id\": \"showArea\",\n        \"label\": \"Show the service-area line\",\n        \"type\": \"toggle\",\n        \"default\": true\n      },\n      {\n        \"id\": \"accent\",\n        \"label\": \"Page colour\",\n        \"type\": \"select\",\n        \"default\": \"teal\",\n        \"options\": [\n          [\"teal\", \"Teal\"],\n          [\"coral\", \"Coral\"],\n          [\"violet\", \"Violet\"]\n        ]\n      },\n      {\n        \"id\": \"rule\",\n        \"label\": \"Contact button has a click rule\",\n        \"type\": \"toggle\",\n        \"default\": true\n      }\n    ]\n  },\n  {\n    \"id\": 2,\n    \"title\": \"Turn a feeling into a direction.\",\n    \"idea\": \"A builder needs an observable change. Name the part, describe what should happen, and say how you will check it. A bounded instruction leaves fewer unrelated decisions open. This does not guarantee that any particular AI will follow it.\",\n    \"task\": \"Describe one change to the hours or Services section. Include an observable check.\",\n    \"first\": \"Try a bounded direction\",\n    \"try\": {\n      \"direction\": \"Put opening hours below Services. Check that the hours are visible on a phone.\",\n      \"scope\": \"one\"\n    },\n    \"boundary\": \"This builds and inspects a brief locally. It does not call or evaluate an AI builder. The checklist recognises a few example terms, not the quality of arbitrary writing.\",\n    \"challenge\": \"Write a different instruction that another person could check without asking what impressive means.\",\n    \"controls\": [\n      {\n        \"id\": \"direction\",\n        \"label\": \"Your direction to the builder\",\n        \"type\": \"text\",\n        \"default\": \"Make it impressive.\"\n      },\n      {\n        \"id\": \"scope\",\n        \"label\": \"Allowed scope\",\n        \"type\": \"select\",\n        \"default\": \"all\",\n        \"options\": [\n          [\"one\", \"One part\"],\n          [\"all\", \"The whole site\"]\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": 3,\n    \"title\": \"Same words. Different appearance.\",\n    \"idea\": \"HTML describes content, CSS describes its appearance, and JavaScript can define an action. These are roles in this small page. A framework may generate or coordinate these instructions in a larger project.\",\n    \"task\": \"Change the heading size. Notice what stays the same.\",\n    \"first\": \"Make the heading bigger\",\n    \"try\": { \"size\": 38 },\n    \"boundary\": \"This is a real local browser page. Changing its heading or style sends no request to an AI service.\",\n    \"challenge\": \"Remove the click rule. Can the page still look exactly the same? Try its Contact button.\",\n    \"controls\": [\n      {\n        \"id\": \"size\",\n        \"label\": \"Heading size\",\n        \"type\": \"range\",\n        \"default\": 26,\n        \"min\": 22,\n        \"max\": 38,\n        \"step\": 1,\n        \"unit\": \"px\"\n      },\n      {\n        \"id\": \"heading\",\n        \"label\": \"The page heading\",\n        \"type\": \"text\",\n        \"default\": \"Repairs near you.\"\n      },\n      {\n        \"id\": \"rule\",\n        \"label\": \"Contact button has a click rule\",\n        \"type\": \"toggle\",\n        \"default\": true\n      }\n    ]\n  },\n  {\n    \"id\": 4,\n    \"title\": \"Can a number be wrong?\",\n    \"idea\": \"An input starts as text. Before multiplying, the program must decide whether that text represents an allowed quantity. Blank, negative and fractional values can mean different things from zero. Validation makes that rule explicit.\",\n    \"task\": \"Try a blank quantity, then zero, then two. Compare the results.\",\n    \"first\": \"Try a blank quantity\",\n    \"try\": { \"quantity\": \"\" },\n    \"boundary\": \"This estimator runs locally and uses fictional units. Its explicit rule allows whole quantities from zero to twenty.\",\n    \"challenge\": \"Change the price per item. Which inputs should still be rejected?\",\n    \"controls\": [\n      { \"id\": \"quantity\", \"label\": \"Number of items\", \"type\": \"text\", \"default\": \"2\" },\n      {\n        \"id\": \"price\",\n        \"label\": \"Price per item\",\n        \"type\": \"range\",\n        \"default\": 25,\n        \"min\": 10,\n        \"max\": 100,\n        \"step\": 5,\n        \"unit\": \"units\"\n      }\n    ]\n  },\n  {\n    \"id\": 5,\n    \"title\": \"One rule. Many records.\",\n    \"idea\": \"A collection holds several records. A loop can apply the same function to each record. A stable identifier distinguishes one record from another; a repeated name is not automatically a repeated identity.\",\n    \"task\": \"Grow the collection. Then introduce a repeated identifier.\",\n    \"first\": \"Add three more services\",\n    \"try\": { \"count\": 6 },\n    \"boundary\": \"The records are generated fictional services. The duplicate check executes in your browser; this is not a database constraint.\",\n    \"challenge\": \"Set the collection to zero. Should the page invent a service to fill the space?\",\n    \"controls\": [\n      {\n        \"id\": \"count\",\n        \"label\": \"Number of services\",\n        \"type\": \"range\",\n        \"default\": 3,\n        \"min\": 0,\n        \"max\": 12,\n        \"step\": 1,\n        \"unit\": \"records\"\n      },\n      {\n        \"id\": \"duplicate\",\n        \"label\": \"Repeat the last identifier\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      { \"id\": \"prefix\", \"label\": \"Service label\", \"type\": \"text\", \"default\": \"Repair\" }\n    ]\n  },\n  {\n    \"id\": 6,\n    \"title\": \"What supports the claim?\",\n    \"idea\": \"An invented example, a person's recollection and checked records support different statements. Counts need a defined sample. Even a checked association does not by itself show why appointments were missed.\",\n    \"task\": \"Change the source and the sample size. Keep the number of missed visits consistent with the sample.\",\n    \"first\": \"Inspect checked records\",\n    \"try\": { \"source\": \"records\" },\n    \"boundary\": \"All people and counts here are fictional teaching inputs. This is not an interview, field study or causal finding.\",\n    \"challenge\": \"Can ten missed visits come from a sample of five? What evidence would you request before choosing a solution?\",\n    \"controls\": [\n      {\n        \"id\": \"source\",\n        \"label\": \"Source of the claim\",\n        \"type\": \"select\",\n        \"default\": \"invented\",\n        \"options\": [\n          [\"invented\", \"AI-invented example\"],\n          [\"memory\", \"Owner's recollection\"],\n          [\"records\", \"Checked visit records\"]\n        ]\n      },\n      {\n        \"id\": \"sample\",\n        \"label\": \"Visits in the sample\",\n        \"type\": \"range\",\n        \"default\": 10,\n        \"min\": 1,\n        \"max\": 50,\n        \"step\": 1,\n        \"unit\": \"visits\"\n      },\n      {\n        \"id\": \"missed\",\n        \"label\": \"Missed visits\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 0,\n        \"max\": 50,\n        \"step\": 1,\n        \"unit\": \"visits\"\n      }\n    ]\n  },\n  {\n    \"id\": 7,\n    \"title\": \"Two missed visits out of how many?\",\n    \"idea\": \"A count and a rate answer different questions. Divide the number of missed eligible visits by all eligible visits in the same period. A target needs the same definition and denominator as the baseline.\",\n    \"task\": \"Keep two missed visits. Change the eligible total from ten to one hundred.\",\n    \"first\": \"Change the denominator\",\n    \"try\": { \"eligible\": \"100\" },\n    \"boundary\": \"These are fictional counts. The displayed rate is arithmetic, not evidence of a product's effectiveness.\",\n    \"challenge\": \"Erase the denominator. Is zero percent an honest replacement for an unknown rate?\",\n    \"controls\": [\n      { \"id\": \"eligible\", \"label\": \"Eligible visits\", \"type\": \"text\", \"default\": \"10\" },\n      {\n        \"id\": \"missed\",\n        \"label\": \"Missed visits\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 0,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"visits\"\n      },\n      {\n        \"id\": \"target\",\n        \"label\": \"Target missed-visit rate\",\n        \"type\": \"range\",\n        \"default\": 10,\n        \"min\": 0,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"%\"\n      }\n    ]\n  },\n  {\n    \"id\": 8,\n    \"title\": \"A journey includes the awkward parts.\",\n    \"idea\": \"A form must help someone act and understand the result. Missing input should produce a useful correction. A lost connection should preserve the draft rather than pretend that a visit was confirmed.\",\n    \"task\": \"Enter a visit identifier, then disconnect the model's connection.\",\n    \"first\": \"Fill the visit identifier\",\n    \"try\": { \"visit\": \"V-42\" },\n    \"boundary\": \"This is a local form-state model. No appointment is sent or saved in a shared service.\",\n    \"challenge\": \"Reconnect. What evidence would distinguish a submitted request from a confirmed appointment?\",\n    \"controls\": [\n      { \"id\": \"visit\", \"label\": \"Visit identifier\", \"type\": \"text\", \"default\": \"\" },\n      { \"id\": \"connected\", \"label\": \"Connection available\", \"type\": \"toggle\", \"default\": true }\n    ]\n  },\n  {\n    \"id\": 9,\n    \"title\": \"Compare a decision, not a headline price.\",\n    \"idea\": \"A recurring fee and an initial build cost accumulate differently. Compare the same period and required capabilities. A cheap option that cannot export required records may fail the need regardless of its arithmetic cost.\",\n    \"task\": \"Change the number of months and the export requirement.\",\n    \"first\": \"Look two years ahead\",\n    \"try\": { \"months\": 24 },\n    \"boundary\": \"All costs and capabilities are fictional. Maintenance, risk, taxes and financing are excluded; this is not a provider recommendation.\",\n    \"challenge\": \"When would the cheaper arithmetic total still be the wrong choice?\",\n    \"controls\": [\n      {\n        \"id\": \"months\",\n        \"label\": \"Comparison period\",\n        \"type\": \"range\",\n        \"default\": 12,\n        \"min\": 1,\n        \"max\": 24,\n        \"step\": 1,\n        \"unit\": \"months\"\n      },\n      {\n        \"id\": \"license\",\n        \"label\": \"Monthly licence\",\n        \"type\": \"range\",\n        \"default\": 20,\n        \"min\": 0,\n        \"max\": 200,\n        \"step\": 5,\n        \"unit\": \"units\"\n      },\n      {\n        \"id\": \"setup\",\n        \"label\": \"Setup cost\",\n        \"type\": \"range\",\n        \"default\": 120,\n        \"min\": 0,\n        \"max\": 500,\n        \"step\": 20,\n        \"unit\": \"units\"\n      },\n      {\n        \"id\": \"build\",\n        \"label\": \"Build cost\",\n        \"type\": \"range\",\n        \"default\": 600,\n        \"min\": 0,\n        \"max\": 2000,\n        \"step\": 50,\n        \"unit\": \"units\"\n      },\n      {\n        \"id\": \"needExport\",\n        \"label\": \"Record export is required\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"vendorExport\",\n        \"label\": \"The package supports export\",\n        \"type\": \"toggle\",\n        \"default\": false\n      }\n    ]\n  },\n  {\n    \"id\": 10,\n    \"title\": \"What would a useful check actually inspect?\",\n    \"idea\": \"A success message describes what an interface says. It does not prove which record changed. An acceptance check should compare the selected record and records that must stay unchanged.\",\n    \"task\": \"Inspect the records instead of only the toast.\",\n    \"first\": \"Check before and after records\",\n    \"try\": { \"check\": \"records\" },\n    \"boundary\": \"The updater and assertions run on fictional records in this browser. A passing check here is not a check of your own application.\",\n    \"challenge\": \"Switch the selected visit. Does the check still catch a change to the wrong record?\",\n    \"controls\": [\n      {\n        \"id\": \"check\",\n        \"label\": \"Evidence inspected\",\n        \"type\": \"select\",\n        \"default\": \"toast\",\n        \"options\": [\n          [\"toast\", \"Success message only\"],\n          [\"records\", \"Selected and other records\"]\n        ]\n      },\n      {\n        \"id\": \"defect\",\n        \"label\": \"The updater changes the wrong record\",\n        \"type\": \"toggle\",\n        \"default\": true\n      },\n      {\n        \"id\": \"selected\",\n        \"label\": \"Selected visit\",\n        \"type\": \"select\",\n        \"default\": \"V-42\",\n        \"options\": [\n          [\"V-42\", \"V-42\"],\n          [\"V-43\", \"V-43\"]\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": 11,\n    \"title\": \"A request has a journey.\",\n    \"idea\": \"The browser sends a request, a server handles it, and a response returns. A client timeout means the client stopped waiting. It does not prove that the server stopped working or that nothing was stored.\",\n    \"task\": \"Make the response slower than the client's timeout.\",\n    \"first\": \"Delay the response\",\n    \"try\": { \"latency\": 1800 },\n    \"boundary\": \"The timings are controlled teaching inputs. No network request or backend write is performed by this model.\",\n    \"challenge\": \"What could go wrong if you retry a timed-out booking with a new request identifier?\",\n    \"controls\": [\n      {\n        \"id\": \"latency\",\n        \"label\": \"Response delay\",\n        \"type\": \"range\",\n        \"default\": 800,\n        \"min\": 0,\n        \"max\": 3000,\n        \"step\": 100,\n        \"unit\": \"ms\"\n      },\n      {\n        \"id\": \"timeout\",\n        \"label\": \"Client stops waiting after\",\n        \"type\": \"range\",\n        \"default\": 1000,\n        \"min\": 100,\n        \"max\": 5000,\n        \"step\": 100,\n        \"unit\": \"ms\"\n      },\n      { \"id\": \"valid\", \"label\": \"Request passes validation\", \"type\": \"toggle\", \"default\": true }\n    ]\n  },\n  {\n    \"id\": 12,\n    \"title\": \"A name is not an identifier.\",\n    \"idea\": \"Two visits can belong to people with the same name. Stable identifiers allow exact lookup. Process memory disappears when that process restarts; persistent storage has a separate lifetime and needs its own protection and recovery.\",\n    \"task\": \"Restart the model with memory storage, then choose persistent storage.\",\n    \"first\": \"Restart the process\",\n    \"try\": { \"restart\": true },\n    \"boundary\": \"This is an explicit storage-lifetime model with fictional records. It is not a running database. Your experiment settings, separately, save in this browser.\",\n    \"challenge\": \"Both records are named Alex. Which identifier selects one visit unambiguously?\",\n    \"controls\": [\n      { \"id\": \"restart\", \"label\": \"Process has restarted\", \"type\": \"toggle\", \"default\": false },\n      {\n        \"id\": \"storage\",\n        \"label\": \"Where records were stored\",\n        \"type\": \"select\",\n        \"default\": \"memory\",\n        \"options\": [\n          [\"memory\", \"Process memory\"],\n          [\"persistent\", \"Persistent store\"]\n        ]\n      },\n      { \"id\": \"lookup\", \"label\": \"Look up a name or identifier\", \"type\": \"text\", \"default\": \"Alex\" }\n    ]\n  },\n  {\n    \"id\": 13,\n    \"title\": \"Two requests. One last slot.\",\n    \"idea\": \"Separate reads can both see an available slot before either write finishes. An atomic reservation rule checks and changes state together. An idempotency key identifies a retry of the same operation rather than a new booking.\",\n    \"task\": \"Make simultaneous requests for fewer slots. Compare the reservation rules.\",\n    \"first\": \"Use an atomic reservation\",\n    \"try\": { \"atomic\": true },\n    \"boundary\": \"This executes a deterministic concurrency model. Separate reads all see the same initial snapshot; it is not a database load test.\",\n    \"challenge\": \"Add retries. What changes when they keep the same request key?\",\n    \"controls\": [\n      {\n        \"id\": \"slots\",\n        \"label\": \"Available slots\",\n        \"type\": \"range\",\n        \"default\": 1,\n        \"min\": 1,\n        \"max\": 5,\n        \"step\": 1,\n        \"unit\": \"slots\"\n      },\n      {\n        \"id\": \"requests\",\n        \"label\": \"Distinct requests arriving together\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 1,\n        \"max\": 8,\n        \"step\": 1,\n        \"unit\": \"requests\"\n      },\n      {\n        \"id\": \"atomic\",\n        \"label\": \"Check and reserve atomically\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"retries\",\n        \"label\": \"Extra retry attempts\",\n        \"type\": \"range\",\n        \"default\": 0,\n        \"min\": 0,\n        \"max\": 5,\n        \"step\": 1,\n        \"unit\": \"attempts\"\n      },\n      {\n        \"id\": \"sameKey\",\n        \"label\": \"Retries keep their original key\",\n        \"type\": \"toggle\",\n        \"default\": false\n      }\n    ]\n  },\n  {\n    \"id\": 14,\n    \"title\": \"Being signed in is not enough.\",\n    \"idea\": \"Authentication establishes an identity. Authorization decides whether that identity may access this record. Hiding a button cannot replace a trusted permission check on the request.\",\n    \"task\": \"Keep customer C7 signed in and ask for C8's visit.\",\n    \"first\": \"Request another customer's visit\",\n    \"try\": { \"owner\": \"C8\" },\n    \"boundary\": \"These are fictional identities and a locally executed policy. No real account, session or private record is accessed.\",\n    \"challenge\": \"Remove the server check. Does the interface's sign-in badge prevent the model from leaking a record?\",\n    \"controls\": [\n      {\n        \"id\": \"caller\",\n        \"label\": \"Requesting identity\",\n        \"type\": \"select\",\n        \"default\": \"C7\",\n        \"options\": [\n          [\"C7\", \"Customer C7\"],\n          [\"C8\", \"Customer C8\"],\n          [\"none\", \"No valid session\"]\n        ]\n      },\n      {\n        \"id\": \"owner\",\n        \"label\": \"Record belongs to\",\n        \"type\": \"select\",\n        \"default\": \"C7\",\n        \"options\": [\n          [\"C7\", \"Customer C7\"],\n          [\"C8\", \"Customer C8\"]\n        ]\n      },\n      {\n        \"id\": \"serverCheck\",\n        \"label\": \"Trusted boundary checks the record owner\",\n        \"type\": \"toggle\",\n        \"default\": true\n      }\n    ]\n  },\n  {\n    \"id\": 15,\n    \"title\": \"Accepted does not mean delivered.\",\n    \"idea\": \"An external service has its own configuration and availability. An acceptance response can acknowledge a request without proving delivery. After an ambiguous timeout, reconciliation or a stable request identifier may be safer than blindly sending again.\",\n    \"task\": \"Add a credential, then change the provider's response.\",\n    \"first\": \"Configure the credential\",\n    \"try\": { \"credential\": true },\n    \"boundary\": \"No credentials are entered and no messages are sent. The switch represents configuration being present, not a secret value.\",\n    \"challenge\": \"Choose an unknown response and add retries. Can you honestly report that exactly one message was delivered?\",\n    \"controls\": [\n      {\n        \"id\": \"credential\",\n        \"label\": \"Required credential is configured\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"provider\",\n        \"label\": \"Provider response\",\n        \"type\": \"select\",\n        \"default\": \"accepted\",\n        \"options\": [\n          [\"accepted\", \"Request accepted\"],\n          [\"offline\", \"Unavailable\"],\n          [\"unknown\", \"Timed out; acceptance unknown\"]\n        ]\n      },\n      {\n        \"id\": \"retries\",\n        \"label\": \"Extra send attempts\",\n        \"type\": \"range\",\n        \"default\": 0,\n        \"min\": 0,\n        \"max\": 5,\n        \"step\": 1,\n        \"unit\": \"attempts\"\n      }\n    ]\n  },\n  {\n    \"id\": 16,\n    \"title\": \"Permission and budget are different boundaries.\",\n    \"idea\": \"A task brief can define the goal, allowed actions, budget and stopping conditions. Sufficient budget does not grant permission. Permission does not remove the need to stop when the budget is exhausted.\",\n    \"task\": \"Give the model enough budget without granting broader authority.\",\n    \"first\": \"Increase the task budget\",\n    \"try\": { \"budget\": 4 },\n    \"boundary\": \"This is a local rule executor, not an autonomous AI agent. Each operation costs one fictional unit; no tool or external system is used.\",\n    \"challenge\": \"Ask for a live change while granting only test-environment access. Should more budget make that allowed?\",\n    \"controls\": [\n      {\n        \"id\": \"budget\",\n        \"label\": \"Task budget\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 0,\n        \"max\": 10,\n        \"step\": 1,\n        \"unit\": \"units\"\n      },\n      {\n        \"id\": \"demand\",\n        \"label\": \"Operations needed\",\n        \"type\": \"range\",\n        \"default\": 3,\n        \"min\": 1,\n        \"max\": 6,\n        \"step\": 1,\n        \"unit\": \"operations\"\n      },\n      {\n        \"id\": \"permission\",\n        \"label\": \"Granted authority\",\n        \"type\": \"select\",\n        \"default\": \"test\",\n        \"options\": [\n          [\"read\", \"Read only\"],\n          [\"test\", \"Test environment\"],\n          [\"live\", \"Explicit live-change authority\"]\n        ]\n      },\n      {\n        \"id\": \"request\",\n        \"label\": \"Requested action\",\n        \"type\": \"select\",\n        \"default\": \"test\",\n        \"options\": [\n          [\"read\", \"Read information\"],\n          [\"test\", \"Change the test environment\"],\n          [\"live\", \"Change the live environment\"]\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": 17,\n    \"title\": \"Parallel work still needs an agreement.\",\n    \"idea\": \"Two workstreams must agree on their interface. More workers can reduce some parallel work, but coordination and integration still cost time. A fast incompatible component does not create a working journey.\",\n    \"task\": \"Make the interface field names agree. Then vary worker count.\",\n    \"first\": \"Agree on the field name\",\n    \"try\": { \"uiField\": \"accessStatus\" },\n    \"boundary\": \"The time model assumes equal independent tasks plus two coordination minutes per extra worker. It is a stated toy assumption, not an estimate of real AI-agent productivity.\",\n    \"challenge\": \"With only one small task, can adding workers increase the model's total time?\",\n    \"controls\": [\n      {\n        \"id\": \"uiField\",\n        \"label\": \"Field the interface expects\",\n        \"type\": \"text\",\n        \"default\": \"status\"\n      },\n      {\n        \"id\": \"serverField\",\n        \"label\": \"Field the server returns\",\n        \"type\": \"text\",\n        \"default\": \"accessStatus\"\n      },\n      {\n        \"id\": \"workers\",\n        \"label\": \"Workers\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 1,\n        \"max\": 6,\n        \"step\": 1,\n        \"unit\": \"workers\"\n      },\n      {\n        \"id\": \"tasks\",\n        \"label\": \"Independent tasks\",\n        \"type\": \"range\",\n        \"default\": 4,\n        \"min\": 1,\n        \"max\": 10,\n        \"step\": 1,\n        \"unit\": \"tasks\"\n      },\n      {\n        \"id\": \"minutes\",\n        \"label\": \"Time per task\",\n        \"type\": \"range\",\n        \"default\": 5,\n        \"min\": 1,\n        \"max\": 20,\n        \"step\": 1,\n        \"unit\": \"minutes\"\n      }\n    ]\n  },\n  {\n    \"id\": 18,\n    \"title\": \"Correct JSON can still invent a fact.\",\n    \"idea\": \"A structured response can be valid JSON and still contradict its source. Parsing, checking the schema and checking factual support are separate operations. An unknown date should remain unknown when the source does not supply one.\",\n    \"task\": \"Replace the invented date with null. Keep a non-empty summary.\",\n    \"first\": \"Keep the unknown date unknown\",\n    \"try\": { \"output\": \"{\\\"date\\\":null,\\\"summary\\\":\\\"Customer called about a repair.\\\"}\" },\n    \"boundary\": \"You are running a real JSON parser and a small source-checking rule on fictional input. No model is called and this does not measure general factual accuracy.\",\n    \"challenge\": \"Enter a source date, then provide a different output date. Which check should reject it?\",\n    \"controls\": [\n      {\n        \"id\": \"output\",\n        \"label\": \"Proposed structured output\",\n        \"type\": \"text\",\n        \"default\": \"{\\\"date\\\":\\\"2026-10-20\\\",\\\"summary\\\":\\\"Customer called about a repair.\\\"}\"\n      },\n      {\n        \"id\": \"sourceDate\",\n        \"label\": \"Date explicitly present in the source (blank means unknown)\",\n        \"type\": \"text\",\n        \"default\": \"\"\n      }\n    ]\n  },\n  {\n    \"id\": 19,\n    \"title\": \"A relevant source can still be the wrong source.\",\n    \"idea\": \"Retrieval can find information related to a question, but relevance alone does not establish freshness or authority. Text inside a retrieved document is information, not permission to perform an action.\",\n    \"task\": \"Bring the policy within the freshness limit, then inspect an instruction embedded in it.\",\n    \"first\": \"Use a current policy\",\n    \"try\": { \"age\": 2 },\n    \"boundary\": \"This is a small keyword-matching source model, not semantic embeddings or a live retrieval service. Its policy and freshness limit are fictional.\",\n    \"challenge\": \"A document says cancel the visit. Does reading that document authorize the application to cancel it?\",\n    \"controls\": [\n      {\n        \"id\": \"question\",\n        \"label\": \"Question\",\n        \"type\": \"text\",\n        \"default\": \"Can I cancel my visit?\"\n      },\n      {\n        \"id\": \"age\",\n        \"label\": \"Age of the policy\",\n        \"type\": \"range\",\n        \"default\": 20,\n        \"min\": 0,\n        \"max\": 30,\n        \"step\": 1,\n        \"unit\": \"days\"\n      },\n      {\n        \"id\": \"maxAge\",\n        \"label\": \"Maximum allowed source age\",\n        \"type\": \"range\",\n        \"default\": 7,\n        \"min\": 0,\n        \"max\": 30,\n        \"step\": 1,\n        \"unit\": \"days\"\n      },\n      {\n        \"id\": \"docAction\",\n        \"label\": \"Document asks to cancel a visit\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"authority\",\n        \"label\": \"Separate user and policy authority allows cancellation\",\n        \"type\": \"toggle\",\n        \"default\": false\n      }\n    ]\n  },\n  {\n    \"id\": 20,\n    \"title\": \"Which mistakes are you counting?\",\n    \"idea\": \"Precision asks how many alerts were correct. Recall asks how many real positive cases were found. A threshold changes which cases trigger an alert; it can trade one kind of error for another.\",\n    \"task\": \"Move the alert threshold and watch the same labelled cases change category.\",\n    \"first\": \"Raise the alert threshold\",\n    \"try\": { \"threshold\": 70 },\n    \"boundary\": \"Scores and labels are deterministic fictional fixtures. These counts do not establish the quality of an actual model or an overall reliability claim.\",\n    \"challenge\": \"Can you increase precision by issuing almost no alerts? What happens to missed cases?\",\n    \"controls\": [\n      {\n        \"id\": \"threshold\",\n        \"label\": \"Alert threshold\",\n        \"type\": \"range\",\n        \"default\": 30,\n        \"min\": 0,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"points\"\n      },\n      {\n        \"id\": \"positives\",\n        \"label\": \"Actually positive cases\",\n        \"type\": \"range\",\n        \"default\": 10,\n        \"min\": 1,\n        \"max\": 50,\n        \"step\": 1,\n        \"unit\": \"cases\"\n      },\n      {\n        \"id\": \"negatives\",\n        \"label\": \"Actually negative cases\",\n        \"type\": \"range\",\n        \"default\": 90,\n        \"min\": 1,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"cases\"\n      }\n    ]\n  },\n  {\n    \"id\": 21,\n    \"title\": \"Does the test notice the defect?\",\n    \"idea\": \"A test is useful when it can expose a relevant mistake. Checking a success toast misses an updater that changes the wrong record. Compare both the intended change and the state that must remain unchanged.\",\n    \"task\": \"Run the record assertion with the wrong-record defect present, then remove the defect.\",\n    \"first\": \"Inspect the changed records\",\n    \"try\": { \"check\": \"records\" },\n    \"boundary\": \"The updater and assertions execute on two local fictional visits. This is a controlled defect, not a test of your real application.\",\n    \"challenge\": \"Choose the other visit. Can a hard-coded assertion still be trusted?\",\n    \"controls\": [\n      {\n        \"id\": \"check\",\n        \"label\": \"Assertion to run\",\n        \"type\": \"select\",\n        \"default\": \"toast\",\n        \"options\": [\n          [\"toast\", \"Toast says Saved\"],\n          [\"records\", \"Only the selected visit changed\"]\n        ]\n      },\n      { \"id\": \"defect\", \"label\": \"Wrong-record defect present\", \"type\": \"toggle\", \"default\": true },\n      {\n        \"id\": \"selected\",\n        \"label\": \"Selected visit\",\n        \"type\": \"select\",\n        \"default\": \"V-42\",\n        \"options\": [\n          [\"V-42\", \"V-42\"],\n          [\"V-43\", \"V-43\"]\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": 22,\n    \"title\": \"Code rollback is not data rollback.\",\n    \"idea\": \"A release needs a compatible build, configuration and data. Reverting code can recover a code-only regression. It cannot automatically undo an incompatible change to stored information.\",\n    \"task\": \"Make configuration complete, then compare rollback with and without a data migration.\",\n    \"first\": \"Supply the required configuration\",\n    \"try\": { \"credential\": true },\n    \"boundary\": \"This is a release-compatibility model. It does not build, deploy or migrate an external application.\",\n    \"challenge\": \"Turn on the incompatible migration and roll code back. Which version can still understand the data?\",\n    \"controls\": [\n      {\n        \"id\": \"credential\",\n        \"label\": \"Required configuration is present\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"build\",\n        \"label\": \"Build and required checks pass\",\n        \"type\": \"toggle\",\n        \"default\": true\n      },\n      {\n        \"id\": \"migration\",\n        \"label\": \"Data migrated to an incompatible v2 schema\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      { \"id\": \"rollback\", \"label\": \"Roll code back to v1\", \"type\": \"toggle\", \"default\": false }\n    ]\n  },\n  {\n    \"id\": 23,\n    \"title\": \"Find where the time went.\",\n    \"idea\": \"A trace divides a journey into observed spans. A slow total does not tell you which component to change. Inspect the relevant span, form a hypothesis, then verify the effect of an intervention.\",\n    \"task\": \"Select the provider span, then change its duration in this controlled trace.\",\n    \"first\": \"Inspect the provider\",\n    \"try\": { \"inspect\": \"provider\" },\n    \"boundary\": \"These durations are synthetic inputs. Changing a slider is an intervention in this model, not a verified diagnosis of an external service.\",\n    \"challenge\": \"Make the database the slowest span. Should the same investigation still come first?\",\n    \"controls\": [\n      {\n        \"id\": \"provider\",\n        \"label\": \"Provider time\",\n        \"type\": \"range\",\n        \"default\": 1900,\n        \"min\": 0,\n        \"max\": 3000,\n        \"step\": 50,\n        \"unit\": \"ms\"\n      },\n      {\n        \"id\": \"database\",\n        \"label\": \"Database time\",\n        \"type\": \"range\",\n        \"default\": 80,\n        \"min\": 0,\n        \"max\": 1000,\n        \"step\": 20,\n        \"unit\": \"ms\"\n      },\n      {\n        \"id\": \"validation\",\n        \"label\": \"Validation time\",\n        \"type\": \"range\",\n        \"default\": 20,\n        \"min\": 0,\n        \"max\": 100,\n        \"step\": 5,\n        \"unit\": \"ms\"\n      },\n      {\n        \"id\": \"inspect\",\n        \"label\": \"Investigate this component\",\n        \"type\": \"select\",\n        \"default\": \"css\",\n        \"options\": [\n          [\"css\", \"CSS\"],\n          [\"validation\", \"Validation\"],\n          [\"database\", \"Database\"],\n          [\"provider\", \"Provider\"]\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": 24,\n    \"title\": \"Doing less work can mean older information.\",\n    \"idea\": \"A cache can reuse a recent result instead of repeating a read. Its freshness policy matters when the source changes. A queue moves work to another time; it does not inherently remove that work.\",\n    \"task\": \"Compare repeated fresh reads with a cached result, then change its age and lifetime.\",\n    \"first\": \"Reuse a cached read\",\n    \"try\": { \"mode\": \"cache\" },\n    \"boundary\": \"Requests target the same key at the same instant. Latency is a fictional sequential-work estimate. This is not a benchmark of a database or cache service.\",\n    \"challenge\": \"Mark the policy as changed after the cached copy. Which displayed results can now be stale?\",\n    \"controls\": [\n      {\n        \"id\": \"mode\",\n        \"label\": \"Read strategy\",\n        \"type\": \"select\",\n        \"default\": \"fresh\",\n        \"options\": [\n          [\"fresh\", \"Read the source every time\"],\n          [\"cache\", \"Reuse until expiry\"],\n          [\"queue\", \"Queue every read\"]\n        ]\n      },\n      {\n        \"id\": \"reads\",\n        \"label\": \"Repeated reads\",\n        \"type\": \"range\",\n        \"default\": 20,\n        \"min\": 1,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"reads\"\n      },\n      {\n        \"id\": \"latency\",\n        \"label\": \"Work per source read\",\n        \"type\": \"range\",\n        \"default\": 200,\n        \"min\": 0,\n        \"max\": 2000,\n        \"step\": 50,\n        \"unit\": \"ms\"\n      },\n      {\n        \"id\": \"age\",\n        \"label\": \"Cached copy age\",\n        \"type\": \"range\",\n        \"default\": 15,\n        \"min\": 0,\n        \"max\": 60,\n        \"step\": 1,\n        \"unit\": \"minutes\"\n      },\n      {\n        \"id\": \"ttl\",\n        \"label\": \"Cache lifetime\",\n        \"type\": \"range\",\n        \"default\": 10,\n        \"min\": 0,\n        \"max\": 60,\n        \"step\": 1,\n        \"unit\": \"minutes\"\n      },\n      {\n        \"id\": \"changed\",\n        \"label\": \"Source changed after the cached copy\",\n        \"type\": \"toggle\",\n        \"default\": true\n      }\n    ]\n  },\n  {\n    \"id\": 25,\n    \"title\": \"Can you get the records back?\",\n    \"idea\": \"A backup's existence is different from a successful restore. Recovery requires the relevant information, a compatible application and checks that the restored state is usable. Reverting a code revision alone does not replace lost records.\",\n    \"task\": \"Restore the snapshot, then query the expected identifiers.\",\n    \"first\": \"Restore the snapshot\",\n    \"try\": { \"restore\": true },\n    \"boundary\": \"This operates on generated arrays in a local model. No real records are deleted, and it is not evidence that a production backup can be restored.\",\n    \"challenge\": \"Remove the backup and retry recovery. Which evidence is now missing?\",\n    \"controls\": [\n      {\n        \"id\": \"restore\",\n        \"label\": \"Restore the saved snapshot\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"count\",\n        \"label\": \"Original records\",\n        \"type\": \"range\",\n        \"default\": 4,\n        \"min\": 1,\n        \"max\": 10,\n        \"step\": 1,\n        \"unit\": \"records\"\n      },\n      {\n        \"id\": \"dropped\",\n        \"label\": \"Records removed by the change\",\n        \"type\": \"range\",\n        \"default\": 2,\n        \"min\": 0,\n        \"max\": 10,\n        \"step\": 1,\n        \"unit\": \"records\"\n      },\n      {\n        \"id\": \"backup\",\n        \"label\": \"A snapshot was taken before the change\",\n        \"type\": \"toggle\",\n        \"default\": true\n      },\n      {\n        \"id\": \"verify\",\n        \"label\": \"Query every expected identifier after recovery\",\n        \"type\": \"toggle\",\n        \"default\": false\n      }\n    ]\n  },\n  {\n    \"id\": 26,\n    \"title\": \"The fastest route may still be blocked.\",\n    \"idea\": \"An unfamiliar domain can contain a prerequisite that a proposed solution ignored. Improving dispatch speed cannot make an unapproved site visit eligible. Investigate the real workflow and separate observations from assumptions.\",\n    \"task\": \"Make preparation faster. Does that give the van permission to leave? Try the visit and find what still blocks it.\",\n    \"first\": \"Try one-minute preparation\",\n    \"try\": { \"dispatch\": 1 },\n    \"boundary\": \"This is an authored maintenance scenario, not an observation about a real organisation. A real project needs authorised investigation.\",\n    \"challenge\": \"Remove the access requirement. Does approval remain the relevant bottleneck?\",\n    \"controls\": [\n      {\n        \"id\": \"dispatch\",\n        \"label\": \"Dispatch preparation time\",\n        \"type\": \"range\",\n        \"default\": 15,\n        \"min\": 1,\n        \"max\": 60,\n        \"step\": 1,\n        \"unit\": \"minutes\"\n      },\n      {\n        \"id\": \"approval\",\n        \"label\": \"Access approval is recorded\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"needsAccess\",\n        \"label\": \"The visit requires access approval\",\n        \"type\": \"toggle\",\n        \"default\": true\n      }\n    ]\n  },\n  {\n    \"id\": 27,\n    \"title\": \"What does this product actually need?\",\n    \"idea\": \"A public information page can be delivered as static files. Shared private records need suitable connected storage and access control. Choose components because of the required behaviour, and account for their operating responsibilities.\",\n    \"task\": \"Add a private-record requirement and compare it with the chosen architecture.\",\n    \"first\": \"Require shared private records\",\n    \"try\": { \"privateRecords\": true },\n    \"boundary\": \"This checks a deliberately simplified capability model. It does not choose a real provider or prove an implementation is secure.\",\n    \"challenge\": \"Choose a connected design. What new data and permission explanations does the project need?\",\n    \"controls\": [\n      {\n        \"id\": \"privateRecords\",\n        \"label\": \"Shared private records are required\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"accounts\",\n        \"label\": \"User accounts are required\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"design\",\n        \"label\": \"Chosen architecture\",\n        \"type\": \"select\",\n        \"default\": \"static\",\n        \"options\": [\n          [\"static\", \"Static files only\"],\n          [\"connected\", \"Site plus suitable connected services\"]\n        ]\n      },\n      {\n        \"id\": \"services\",\n        \"label\": \"Independently operated components\",\n        \"type\": \"range\",\n        \"default\": 5,\n        \"min\": 1,\n        \"max\": 8,\n        \"step\": 1,\n        \"unit\": \"components\"\n      }\n    ]\n  },\n  {\n    \"id\": 28,\n    \"title\": \"A local improvement can cost the whole workflow.\",\n    \"idea\": \"Saving time at one step is not the same as a net benefit. Include extra correction work and actual adoption. A faster tool that is not used does not deliver that proposed saving to the workflow.\",\n    \"task\": \"Keep the dispatch saving fixed. Reduce downstream rework and change adoption.\",\n    \"first\": \"Reduce correction work\",\n    \"try\": { \"rework\": 3 },\n    \"boundary\": \"These are fictional scenario inputs, with adoption rounded to whole people. The total is arithmetic, not a measured pilot result or a financial return claim.\",\n    \"challenge\": \"Set adoption to zero. What would you investigate before building more features?\",\n    \"controls\": [\n      {\n        \"id\": \"rework\",\n        \"label\": \"Extra correction work per person\",\n        \"type\": \"range\",\n        \"default\": 20,\n        \"min\": 0,\n        \"max\": 30,\n        \"step\": 1,\n        \"unit\": \"min/day\"\n      },\n      {\n        \"id\": \"saved\",\n        \"label\": \"Dispatch time saved per person\",\n        \"type\": \"range\",\n        \"default\": 10,\n        \"min\": 0,\n        \"max\": 30,\n        \"step\": 1,\n        \"unit\": \"min/day\"\n      },\n      {\n        \"id\": \"adoption\",\n        \"label\": \"Adoption in the scenario\",\n        \"type\": \"range\",\n        \"default\": 60,\n        \"min\": 0,\n        \"max\": 100,\n        \"step\": 1,\n        \"unit\": \"%\"\n      },\n      {\n        \"id\": \"people\",\n        \"label\": \"Eligible people\",\n        \"type\": \"range\",\n        \"default\": 5,\n        \"min\": 1,\n        \"max\": 20,\n        \"step\": 1,\n        \"unit\": \"people\"\n      }\n    ]\n  },\n  {\n    \"id\": 29,\n    \"title\": \"Can someone else keep the journey working?\",\n    \"idea\": \"A handoff includes opening instructions, configuration, access, recovery and evidence. A provider replacement also needs a compatible interface and a fresh journey check. Source files alone do not establish an operable handoff.\",\n    \"task\": \"Prepare the guide and access, then inspect the replacement provider's field name.\",\n    \"first\": \"Prepare the operator handoff\",\n    \"try\": { \"guide\": true, \"access\": true, \"check\": true },\n    \"boundary\": \"This executes a small adapter-contract check with fictional configuration flags. It is not a trial by a real fresh operator.\",\n    \"challenge\": \"Make the provider field match accessStatus. Which real journey would you ask another operator to demonstrate?\",\n    \"controls\": [\n      {\n        \"id\": \"guide\",\n        \"label\": \"Opening and recovery guide is present\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"access\",\n        \"label\": \"Required operator access is available\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"check\",\n        \"label\": \"Run the replacement journey check\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"field\",\n        \"label\": \"Replacement provider's field\",\n        \"type\": \"text\",\n        \"default\": \"status\"\n      }\n    ]\n  },\n  {\n    \"id\": 30,\n    \"title\": \"A new requirement reveals your system.\",\n    \"idea\": \"An unfamiliar change tests whether the system and its explanation still fit the need. Trace the changed journey, identify a missing component or boundary, and direct a correction. A simulated success or polished explanation is not a professional capability certificate.\",\n    \"task\": \"Change the requirement. Add only the components needed for that journey.\",\n    \"first\": \"Try private customer information\",\n    \"try\": { \"need\": \"private\" },\n    \"boundary\": \"This is a compositional teaching model. Graduation still requires your own useful product, explanation, fresh variation and reviewer observations.\",\n    \"challenge\": \"Switch to a grounded AI helper. What does a permitted source add that a database alone does not?\",\n    \"controls\": [\n      {\n        \"id\": \"need\",\n        \"label\": \"Changed requirement\",\n        \"type\": \"select\",\n        \"default\": \"public\",\n        \"options\": [\n          [\"public\", \"Public information\"],\n          [\"private\", \"Private customer information\"],\n          [\"ai\", \"Grounded AI helper\"]\n        ]\n      },\n      {\n        \"id\": \"server\",\n        \"label\": \"Suitable connected application and storage\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"permissions\",\n        \"label\": \"Trusted record permission check\",\n        \"type\": \"toggle\",\n        \"default\": false\n      },\n      {\n        \"id\": \"source\",\n        \"label\": \"Permitted supporting knowledge source\",\n        \"type\": \"toggle\",\n        \"default\": false\n      }\n    ]\n  }\n]\n")
