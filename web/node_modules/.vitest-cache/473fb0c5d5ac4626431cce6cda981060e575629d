const __vite_ssr_export_default__ = /* #__PURE__ */ JSON.parse("[\n  {\n    \"id\": 1,\n    \"stage\": 1,\n    \"title\": \"Make a useful website\",\n    \"problem\": \"A neighbourhood repair service answers the same questions every day: what do you fix, where do you work, and how do I contact you? Start with a small, accurate information site. Use a fictional business until you have permission to use real details.\",\n    \"outcome\": \"A useful site you can open and explain, with AI allowed to create every file.\",\n    \"foundation\": [\"product\", \"stack\", \"execution\", \"interfaces\"],\n    \"concepts\": [\n      {\n        \"name\": \"Outcome and implementation\",\n        \"explanation\": \"An outcome is what someone can accomplish. Implementation is the machinery that makes it possible. Tell AI the visitor's task and the limits before choosing a tool. A beautiful page that omits the service area has missed the outcome.\",\n        \"example\": \"A visitor can find the service area and contact method without asking you.\",\n        \"misconception\": \"A screenshot proves the website works. It only shows one view; links and small screens still need checking.\"\n      },\n      {\n        \"name\": \"Browser and technology stack\",\n        \"explanation\": \"A browser reads page structure, applies styles, and runs browser behaviour. Hosting makes files available to other devices. A stack is the collection of technologies actually used. A simple site can use HTML and CSS with no database or live AI. AI helping you build is different from AI running inside the product.\",\n        \"example\": \"HTML supplies a contact link; CSS gives it a clear appearance; the browser follows it.\",\n        \"misconception\": \"Every website needs a backend. An information site may only need hosted files.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Visitor opens URL\",\n        \"runs\": \"Visitor's device\"\n      },\n      {\n        \"name\": \"Site files arrive\",\n        \"runs\": \"Hosting → browser\"\n      },\n      {\n        \"name\": \"Browser displays page\",\n        \"runs\": \"Visitor's device\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"A visitor presses Contact. Choose what the button actually does.\",\n      \"options\": [\n        {\n          \"label\": \"No destination\",\n          \"result\": \"The page stays here. The visitor cannot contact the service.\",\n          \"why\": \"A visible button needs a real behaviour. Appearance alone is insufficient.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"Open an email draft\",\n          \"result\": \"The visitor's configured mail app can open a draft. Nothing has been sent.\",\n          \"why\": \"An email link hands off to another app; it is not a server sending a message.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"Show a phone number\",\n          \"result\": \"The visitor can read the number and choose whether to call.\",\n          \"why\": \"This is a simple useful outcome without a database or account.\",\n          \"node\": 2\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"The heading says Welcome and the contact button has no destination.\",\n      \"action\": \"Ask AI to name the repair service, show its area and hours, and use a clearly labelled contact link.\",\n      \"after\": \"A visitor can answer the three common questions and reach a contact option.\",\n      \"lesson\": \"Inspect the actual files with AI. If the product only contains static files, explain those files rather than inventing a server.\"\n    },\n    \"project\": {\n      \"title\": \"Your first useful service site\",\n      \"brief\": \"Create a small information website for a repair service or another useful local service. It must show services, area, hours and a working contact option. Use truthful fictional details and no payment or private data.\",\n      \"steps\": [\n        \"Choose who your page is for and the one thing they need to do. Ask an AI builder or coding assistant to create the page and explain how to open it.\",\n        \"Open the result yourself. Ask AI to improve one confusing part and show which files and technologies make the page work.\",\n        \"Try the page on a narrow screen and using a keyboard. Save the files or a preview you can reopen. Choose hosting later when you are ready to publish.\"\n      ],\n      \"checks\": [\n        \"A visitor can find services, area and hours in the actual page.\",\n        \"The contact action has the promised behaviour; I record whether it opens another app or sends anything.\",\n        \"I opened the site at phone width and used the contact link with a keyboard; I recorded what happened.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain the difference between the visitor's outcome and the files AI generated.\",\n      \"locate\": \"Find the actual page, its styles and its hosting or local preview. What is absent?\",\n      \"predict\": \"If hosting is unavailable, can a new visitor load the site? What about an already loaded page?\",\n      \"compare\": \"Compare a static site with an app that stores enquiries. Why choose one now?\",\n      \"challenge\": \"AI says the contact button stores messages in a database. What would you inspect or try to establish whether this is true?\",\n      \"guide\": \"Ask the learner to open their own contact action, trace it, and identify actual technologies. A copied diagram with an imaginary database needs revision.\",\n      \"variations\": [\n        \"The owner changes the service area. Show which result must change and verify it.\",\n        \"A visitor has no mail app configured. Explain the limitation and propose another contact option.\"\n      ]\n    },\n    \"reuse\": [1, 13, 14]\n  },\n  {\n    \"id\": 2,\n    \"stage\": 1,\n    \"title\": \"Turn preferences into clear direction\",\n    \"problem\": \"The site exists, but 'make it better' gives AI too little direction. A visitor cannot find the opening hours. Improve one observable task instead of changing everything at once.\",\n    \"outcome\": \"An improved site with a small before-and-after record.\",\n    \"foundation\": [\"product\", \"collaboration\", \"quality\"],\n    \"concepts\": [\n      {\n        \"name\": \"Constraints and acceptance\",\n        \"explanation\": \"A constraint limits a solution: available budget, screen size, language or permitted data. An acceptance criterion describes an observable result. Together they let an agent choose an implementation while preserving what matters.\",\n        \"example\": \"At phone width, opening hours appear under Services and the contact link remains usable.\",\n        \"misconception\": \"Specific direction means prescribing every line of code. You can specify the result and let AI choose the details.\"\n      },\n      {\n        \"name\": \"Iteration and feedback\",\n        \"explanation\": \"An iteration is a small change followed by observation. Name what confused the visitor, request a change, then repeat the same task. A visual preference is useful feedback, but it differs from evidence that a task became easier.\",\n        \"example\": \"Compare whether someone can find the hours before and after moving them.\",\n        \"misconception\": \"More changes always mean more progress. A large rewrite can hide which change helped.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Observe a task\",\n        \"runs\": \"Person + current site\"\n      },\n      {\n        \"name\": \"Give bounded direction\",\n        \"runs\": \"AI workspace\"\n      },\n      {\n        \"name\": \"Repeat the task\",\n        \"runs\": \"Actual site\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"Choose the instruction you give the builder. These are prepared examples, not live AI responses.\",\n      \"options\": [\n        {\n          \"label\": \"Make it impressive\",\n          \"result\": \"Several visual changes; opening hours may still be hidden.\",\n          \"why\": \"No observable target or boundary was given.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"Move hours below Services\",\n          \"result\": \"One targeted change with a clear place to check.\",\n          \"why\": \"The implementation can vary while the acceptance condition stays concrete.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"Replace the whole site\",\n          \"result\": \"The original contact option may disappear along with the old layout.\",\n          \"why\": \"A broad change needs preservation criteria as well as a desired appearance.\",\n          \"node\": 1\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"A user scrolls past the hours twice.\",\n      \"action\": \"Ask AI to put Hours below Services on phones, preserve the contact destination, and show the changed result.\",\n      \"after\": \"Repeat the same find-the-hours task and check the contact link.\",\n      \"lesson\": \"Record observations, including when the change does not help. An AI report of success is a claim to check.\"\n    },\n    \"project\": {\n      \"title\": \"One change a visitor can notice\",\n      \"brief\": \"Improve the mission-1 site using one observed confusion, two acceptance criteria and one preservation constraint.\",\n      \"steps\": [\n        \"Ask permission to watch someone try your page, or clearly label your own walkthrough as a practice scenario. Name one thing that confused the visitor.\",\n        \"Ask AI for one small change to address that confusion. Keep a working part of the page so you can compare before and after.\",\n        \"Repeat the same task and compare the two versions. Keep or revise the change based on what you observed.\"\n      ],\n      \"checks\": [\n        \"My request names an observable result and a constraint.\",\n        \"The changed site satisfies both acceptance criteria I wrote before the change.\",\n        \"The preserved behaviour still works and my before/after observations are recorded.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain a constraint and an acceptance criterion from your change.\",\n      \"locate\": \"Show the changed part and the behaviour you preserved.\",\n      \"predict\": \"If the site changes language and labels become longer, what might break?\",\n      \"compare\": \"Compare a targeted improvement with a redesign. When would each fit?\",\n      \"challenge\": \"AI says prettier colours prove visitors find the hours faster. What evidence is missing?\",\n      \"guide\": \"Change a constraint and ask the learner to revise their criteria, then inspect the result together.\",\n      \"variations\": [\n        \"The owner needs an Urdu version with longer labels. Revise your criteria.\",\n        \"The proposed change looks better but hides the contact link. Decide what to do and explain why.\"\n      ]\n    },\n    \"reuse\": [16, 26]\n  },\n  {\n    \"id\": 3,\n    \"stage\": 1,\n    \"title\": \"Understand what a page does\",\n    \"problem\": \"The owner asks to change a label, a colour and what happens after a click. These changes affect different parts of the page. Learn the layers before asking AI to change them.\",\n    \"outcome\": \"An annotated page showing structure, appearance and behaviour in the actual stack.\",\n    \"foundation\": [\"interfaces\", \"stack\", \"execution\"],\n    \"concepts\": [\n      {\n        \"name\": \"Structure, presentation and behaviour\",\n        \"explanation\": \"HTML gives content meaning and structure. CSS controls presentation. JavaScript can change state and respond to events. Frameworks and libraries organize this work; they do not remove what the browser ultimately does.\",\n        \"example\": \"A labelled form field is structure; its width is presentation; showing an error on submit is behaviour.\",\n        \"misconception\": \"A framework is a new browser language. It usually produces or coordinates familiar browser technologies.\"\n      },\n      {\n        \"name\": \"Components and dependencies\",\n        \"explanation\": \"A component is a reusable interface part with a responsibility. A library supplies reusable capabilities; a framework sets broader patterns. Configuration and versions affect how these parts build and run. Inspect the project's actual manifest and files with AI.\",\n        \"example\": \"One ContactCard component can show the same contact details on two pages.\",\n        \"misconception\": \"Every tool named in an AI explanation is installed. Check the actual project.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Structure\",\n        \"runs\": \"HTML / rendered markup\"\n      },\n      {\n        \"name\": \"Presentation\",\n        \"runs\": \"CSS in browser\"\n      },\n      {\n        \"name\": \"Behaviour\",\n        \"runs\": \"JavaScript in browser, if used\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"Change one layer of this prepared page model.\",\n      \"options\": [\n        {\n          \"label\": \"Change the heading\",\n          \"result\": \"Content changes from Welcome to Local repairs. Layout rules and click behaviour stay the same.\",\n          \"why\": \"This changes structure/content, not the contact action.\",\n          \"node\": 0\n        },\n        {\n          \"label\": \"Increase text size\",\n          \"result\": \"The same content and action are displayed with larger text.\",\n          \"why\": \"A presentation change may alter wrapping and layout.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"Reveal hours on click\",\n          \"result\": \"A click changes visible state to show opening hours.\",\n          \"why\": \"This is behaviour. A server is not required for a local reveal.\",\n          \"node\": 2\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"Two pages show different contact hours.\",\n      \"action\": \"Ask AI to locate the duplicated information and propose one shared source or component.\",\n      \"after\": \"Changing the shared hours updates both places when rebuilt or rerendered as appropriate.\",\n      \"lesson\": \"Abstraction reduces repeated decisions, but a shared dependency also means one mistake can affect several places.\"\n    },\n    \"project\": {\n      \"title\": \"A map of your page\",\n      \"brief\": \"Annotate the real service site, identify its actual stack, and ask AI to make one content, one style and one behaviour change.\",\n      \"steps\": [\n        \"Ask AI to inspect your page's files and list the technologies it actually uses. Include any file that lists the project's libraries or packages.\",\n        \"Change the page's words, appearance and button action separately. Observe what changes and what stays the same each time.\",\n        \"Label a screenshot and draw a map showing which files or tools control each part. Include the instructions used to start or build your page.\"\n      ],\n      \"checks\": [\n        \"The map correctly identifies the actual structure, styling and behaviour technologies.\",\n        \"Each of my three changes has a separate observed result.\",\n        \"A shared element remains consistent across its uses; I explain what builds or runs it.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain HTML, CSS and browser behaviour using parts of your own page.\",\n      \"locate\": \"Find a component or repeated part, its dependency and the project's start instructions.\",\n      \"predict\": \"What changes if a shared contact component displays the wrong hours?\",\n      \"compare\": \"Compare plain HTML/CSS with the framework actually used, or a plausible framework alternative.\",\n      \"challenge\": \"AI says a CSS colour rule sends enquiries to the server. Trace the action to check this claim.\",\n      \"guide\": \"Ask for one requested change in an unfamiliar area of the page and a prediction of which layer is affected.\",\n      \"variations\": [\n        \"The same contact card is needed on a second page. Explain a suitable boundary.\",\n        \"Styles load but the behaviour script fails. Predict which tasks still work.\"\n      ]\n    },\n    \"reuse\": [13]\n  },\n  {\n    \"id\": 4,\n    \"stage\": 1,\n    \"title\": \"Make an interaction work\",\n    \"problem\": \"Visitors want an estimated repair price before contacting the business. A calculator must distinguish a number from text and reject impossible quantities.\",\n    \"outcome\": \"A small estimator with explainable rules and invalid-input behaviour.\",\n    \"foundation\": [\"logic\", \"interfaces\", \"quality\"],\n    \"concepts\": [\n      {\n        \"name\": \"Input, types and conditions\",\n        \"explanation\": \"Input is information entering the program. A type describes what kind it is: text, number or a true/false value. A condition chooses a path. Text '2' must be interpreted appropriately before numeric work; a blank field is not automatically a sensible zero.\",\n        \"example\": \"If quantity is a whole number from 0 to 20, calculate; otherwise explain how to correct it. This example deliberately allows zero items.\",\n        \"misconception\": \"A number-looking field guarantees valid input. Validation must check the actual value.\"\n      },\n      {\n        \"name\": \"Functions and state\",\n        \"explanation\": \"A function applies a named rule to inputs and produces a result. State is information the program currently remembers. A calculator's current quantity can be temporary browser state; reloading may reset it unless persistence was added.\",\n        \"example\": \"quote(2, 25) returns 50. Changing the quantity replaces the displayed estimate.\",\n        \"misconception\": \"Anything visible on screen is permanently saved.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Quantity input\",\n        \"runs\": \"Browser state\"\n      },\n      {\n        \"name\": \"Validate and multiply\",\n        \"runs\": \"Browser function\"\n      },\n      {\n        \"name\": \"Estimate or error\",\n        \"runs\": \"Browser display\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"The prepared estimator charges 25 units per item. Change the quantity.\",\n      \"options\": [\n        {\n          \"label\": \"2 items\",\n          \"result\": \"Estimate: 50 units.\",\n          \"why\": \"Two valid items × 25 = 50. This is an estimate, not a payment.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"Blank input\",\n          \"result\": \"Enter a whole quantity from 0 to 20. No estimate is shown for blank input.\",\n          \"why\": \"Missing information needs a useful error, not an invented value.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"−1 item\",\n          \"result\": \"Quantity must be at least 0. No estimate is shown for negative input.\",\n          \"why\": \"The value is numeric but violates the business rule.\",\n          \"node\": 1\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"The form displays −25 for −1 item.\",\n      \"action\": \"Ask AI to validate the permitted range before calculating, and show a useful error without losing other input.\",\n      \"after\": \"2 gives 50; blank and −1 produce explanations.\",\n      \"lesson\": \"The expected outcomes come from the business rule. A test copied from the broken calculation would preserve the defect.\"\n    },\n    \"project\": {\n      \"title\": \"A reliable service estimator\",\n      \"brief\": \"Add a small estimator to the service site. Define units, valid range and an honest estimate label. AI may produce the implementation and tests.\",\n      \"steps\": [\n        \"Before building, write three examples of a quantity and the result you expect. Include a valid number, a blank entry and an invalid number.\",\n        \"Ask AI to build the calculation, reject inputs outside your rule, and show clear feedback that also works with a keyboard and screen reader.\",\n        \"Try valid, missing and invalid quantities yourself. Explain where the calculation runs and whether the values remain after a page reload.\"\n      ],\n      \"checks\": [\n        \"A valid example produces the expected amount and units.\",\n        \"Missing and invalid quantities produce useful errors without a misleading estimate.\",\n        \"A changed valid input updates the result; reload behaviour matches my system explanation.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain input, type, condition, function and state through the estimator.\",\n      \"locate\": \"Show where the actual rule runs and where current input lives.\",\n      \"predict\": \"Predict the result for a new boundary input before running it.\",\n      \"compare\": \"Compare calculating in the browser with checking a final price on a server.\",\n      \"challenge\": \"AI says negative input is safe because it is a number. Explain and demonstrate the missing rule.\",\n      \"guide\": \"Give a new price or range. Ask for a prediction and an explanation of the validation boundary with AI available.\",\n      \"variations\": [\n        \"The first item costs 25 and each extra item costs 15. Predict two examples.\",\n        \"The owner allows half-hour units. Which validation rule must change?\"\n      ]\n    },\n    \"reuse\": [2, 3, 4]\n  },\n  {\n    \"id\": 5,\n    \"stage\": 1,\n    \"title\": \"Learn through experiments\",\n    \"problem\": \"The service lists several repair options. Copying the same calculation for each one makes updates inconsistent. Use a collection and a reusable rule, then test how one change affects all results.\",\n    \"outcome\": \"A generated service list with a reusable rule and a prediction log.\",\n    \"foundation\": [\"logic\", \"data\", \"architecture\"],\n    \"concepts\": [\n      {\n        \"name\": \"Collections and loops\",\n        \"explanation\": \"A collection groups values. Each service record can contain an identifier, name and price. A loop repeats work for records in the collection. An empty collection needs a sensible result too; repetition does not guarantee there is anything to display.\",\n        \"example\": \"Three service records become three cards; an empty list shows No services available.\",\n        \"misconception\": \"A loop automatically knows which records are valid or unique.\"\n      },\n      {\n        \"name\": \"Abstraction and numeric precision\",\n        \"explanation\": \"An abstraction hides repeated detail behind a useful rule. One price-formatting function keeps displays consistent. Computers also use finite number representations; monetary calculations need an explicit rounding rule, often using integer minor units.\",\n        \"example\": \"Store 1250 cents for 12.50 and format the display consistently.\",\n        \"misconception\": \"Displayed decimal places guarantee exact arithmetic.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Service records\",\n        \"runs\": \"Local collection\"\n      },\n      {\n        \"name\": \"Repeat shared rule\",\n        \"runs\": \"Program loop + function\"\n      },\n      {\n        \"name\": \"Service cards\",\n        \"runs\": \"Browser\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"Apply a shared display rule to a prepared collection.\",\n      \"options\": [\n        {\n          \"label\": \"3 services\",\n          \"result\": \"3 cards, each formatted using the same price rule.\",\n          \"why\": \"The loop applies the abstraction once per record.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"0 services\",\n          \"result\": \"No services available. No price cards.\",\n          \"why\": \"An empty list is a valid boundary case, not three blank records.\",\n          \"node\": 2\n        },\n        {\n          \"label\": \"Duplicate ID\",\n          \"result\": \"Two records share an identity; flag the conflict before accepting them.\",\n          \"why\": \"A repeated operation does not solve record identity or data correctness.\",\n          \"node\": 0\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"Three copied price labels round amounts differently.\",\n      \"action\": \"Ask AI for one collection and shared formatter; specify the minor unit and rounding policy.\",\n      \"after\": \"Changing the formatter updates all three outputs consistently.\",\n      \"lesson\": \"Predict the effect of a changed record and a changed shared rule separately. This makes the hidden repetition easier to understand.\"\n    },\n    \"project\": {\n      \"title\": \"A reusable service catalogue\",\n      \"brief\": \"Generate service cards from records using one reusable formatting rule. Add empty-list and duplicate-identity handling.\",\n      \"steps\": [\n        \"Choose the information each service needs, such as an identifier, name and price. Write three fictional service records.\",\n        \"Ask AI to turn those records into cards using one shared display and price rule. Follow one record from the stored data to its visible card.\",\n        \"Predict what should happen when you add a fourth record, remove all records or reuse an identifier. Try each case and save what happened.\"\n      ],\n      \"checks\": [\n        \"Adding one valid record adds one correct card without copied layout work.\",\n        \"No records produces an understandable empty state.\",\n        \"Duplicate identities and the monetary rounding policy are handled as specified.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain a collection, a loop and an abstraction using this catalogue.\",\n      \"locate\": \"Identify the records, the repeated work and the shared formatting rule.\",\n      \"predict\": \"What changes if one price changes? What if the shared rule changes?\",\n      \"compare\": \"Compare copied cards with a generated list, including the risk of a shared mistake.\",\n      \"challenge\": \"AI says 0.1 + 0.2 always equals exactly 0.3 in every runtime. How would you investigate and choose a money representation?\",\n      \"guide\": \"Ask the learner to predict empty, added and duplicated records, then distinguish local data from persistent shared storage.\",\n      \"variations\": [\n        \"Prices now have a currency per record. Explain the required data and rule changes.\",\n        \"One record is missing its name. Predict a safe display or rejection policy.\"\n      ]\n    },\n    \"reuse\": [3, 4, 5]\n  },\n  {\n    \"id\": 6,\n    \"stage\": 2,\n    \"title\": \"Investigate a workflow\",\n    \"problem\": \"The service owner asks for an AI booking app. Before agreeing, discover how requests actually become appointments. The missing step may be checking equipment or contacting a customer, not generating a new screen.\",\n    \"outcome\": \"An evidence-labelled workflow map and one unresolved question.\",\n    \"foundation\": [\"product\", \"evidence\", \"collaboration\"],\n    \"concepts\": [\n      {\n        \"name\": \"Discovery and domain knowledge\",\n        \"explanation\": \"Discovery investigates what people do, why, and under which constraints. Domain knowledge is understanding the actual work: a technician may need equipment, access permission or travel time. A requested feature is a possible solution, not a complete statement of the problem.\",\n        \"example\": \"Watch how a request moves from a phone call to a technician's schedule.\",\n        \"misconception\": \"An AI-generated interview is evidence that a customer said something.\"\n      },\n      {\n        \"name\": \"Observation and provenance\",\n        \"explanation\": \"Provenance records where information came from. Separate direct observations, reported experiences, assumptions and fictional scenarios. Missing information should become a question instead of an invented fact.\",\n        \"example\": \"'Owner reported three missed visits' differs from a checked count in appointment records.\",\n        \"misconception\": \"A confident summary makes uncertain source information certain.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Incoming request\",\n        \"runs\": \"Customer / existing channel\"\n      },\n      {\n        \"name\": \"Eligibility and scheduling\",\n        \"runs\": \"Staff workflow\"\n      },\n      {\n        \"name\": \"Visit and follow-up\",\n        \"runs\": \"Technician + customer\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"Choose the source behind the claim 'appointments are often missed'.\",\n      \"options\": [\n        {\n          \"label\": \"AI invented example\",\n          \"result\": \"Useful practice scenario; no evidence about this business.\",\n          \"why\": \"Generated plausibility is not an observation.\",\n          \"node\": 0\n        },\n        {\n          \"label\": \"Owner's recollection\",\n          \"result\": \"Reported experience; ask for dates and examples.\",\n          \"why\": \"A recollection is valuable context with possible selection and memory limits.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"Checked visit records\",\n          \"result\": \"Observed records, subject to missing entries and definitions.\",\n          \"why\": \"Inspect what missed means and how the records were produced.\",\n          \"node\": 2\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"The brief says Build an AI scheduler.\",\n      \"action\": \"Ask how yesterday's appointment was arranged, where it stalled, and what staff did next.\",\n      \"after\": \"The map shows that site-access confirmation is missing before dispatch.\",\n      \"lesson\": \"AI can prepare, conduct or analyse research when appropriately authorized. Label who or what supplied the evidence.\"\n    },\n    \"project\": {\n      \"title\": \"The workflow before the app\",\n      \"brief\": \"Investigate an authorized repair or maintenance workflow, or use a clearly labelled fictional scenario. Map current steps, people, information, delays and incentives.\",\n      \"steps\": [\n        \"Choose a real-world process and where you could learn about it. Ask AI to help prepare questions about what people recently did.\",\n        \"Collect observations or clearly label practice examples. Draw the current steps and name one requirement that the first request did not mention.\",\n        \"Check your interpretation with a participant if one is available. Otherwise, write down which conclusions are still assumptions.\"\n      ],\n      \"checks\": [\n        \"Each important claim has an identifiable source or is labelled as an assumption/scenario.\",\n        \"The map includes an actual constraint and a handoff between people or systems.\",\n        \"The brief records a missing requirement, an unresolved question and how to investigate it.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain why the requested feature may differ from the underlying problem.\",\n      \"locate\": \"Find a handoff and the source supporting it in your map.\",\n      \"predict\": \"What happens if access approval arrives after a technician is dispatched?\",\n      \"compare\": \"Compare observing a recent task with asking whether someone likes a proposed app.\",\n      \"challenge\": \"AI claims five fictional interviews prove demand. Explain what they establish and what evidence is still needed.\",\n      \"guide\": \"Ask which map details are observed, reported or assumed. Introduce a domain constraint and check the learner can revise the map.\",\n      \"variations\": [\n        \"Technicians can only accept jobs for equipment they are trained on. Revise the workflow.\",\n        \"The owner and receptionist disagree about the biggest delay. Plan an investigation.\"\n      ]\n    },\n    \"reuse\": [26]\n  },\n  {\n    \"id\": 7,\n    \"stage\": 2,\n    \"title\": \"Define a worthwhile result\",\n    \"problem\": \"A new system could make the appointment screen faster while increasing missed visits. Decide which result matters before building more features.\",\n    \"outcome\": \"A short product brief with a baseline, success measure and explicit scope.\",\n    \"foundation\": [\"product\", \"evidence\", \"collaboration\"],\n    \"concepts\": [\n      {\n        \"name\": \"Outcomes, baselines and denominators\",\n        \"explanation\": \"A baseline is the starting observation. An outcome measures the change people need. A rate needs a denominator: two missed visits out of ten differs from two out of a hundred. Define exclusions consistently before comparing periods.\",\n        \"example\": \"Count preventable missed visits per 100 eligible appointments, not just app logins.\",\n        \"misconception\": \"A larger usage count proves the business outcome improved.\"\n      },\n      {\n        \"name\": \"Scope and priorities\",\n        \"explanation\": \"Scope names what is included and excluded. Priorities express which result should win when time or cost is limited. A small complete workflow is often easier to evaluate than many partly connected features.\",\n        \"example\": \"Confirm access before dispatch; postpone route optimization until the first change is measured.\",\n        \"misconception\": \"Anything useful belongs in the first release.\"\n      }\n    ],\n    \"flow\": [\n      {\n        \"name\": \"Define eligible visits\",\n        \"runs\": \"Business definition\"\n      },\n      {\n        \"name\": \"Measure current result\",\n        \"runs\": \"Evidence / records\"\n      },\n      {\n        \"name\": \"Set a bounded target\",\n        \"runs\": \"Product brief\"\n      }\n    ],\n    \"experiment\": {\n      \"prompt\": \"Prepared counts: 2 missed visits. Change the denominator.\",\n      \"options\": [\n        {\n          \"label\": \"10 eligible visits\",\n          \"result\": \"Missed-visit rate: 20%.\",\n          \"why\": \"2 ÷ 10 = 0.20. Small samples also produce uncertain estimates.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"100 eligible visits\",\n          \"result\": \"Missed-visit rate: 2%.\",\n          \"why\": \"The same count can represent a very different rate.\",\n          \"node\": 1\n        },\n        {\n          \"label\": \"Denominator unknown\",\n          \"result\": \"The rate cannot be calculated honestly.\",\n          \"why\": \"Missing information cannot be replaced with an impressive percentage.\",\n          \"node\": 0\n        }\n      ]\n    },\n    \"example\": {\n      \"before\": \"Success means people use the dashboard.\",\n      \"action\": \"Define eligible visits, measure a starting rate, choose a target period and record other changes affecting it.\",\n      \"after\": \"The brief targets fewer preventable missed visits, with staff workload as a guardrail.\",\n      \"lesson\": \"Before/after change alone does not establish causation. Record uncertainty and plausible alternative explanations.\"\n    },\n    \"project\": {\n      \"title\": \"A one-page outcome brief\",\n      \"brief\": \"Turn the workflow investigation into a measurable, bounded improvement with a baseline or a labelled plan to obtain one.\",\n      \"steps\": [\n        \"Write who has the problem, what they do now and what it costs them. Name the observations that support your description.\",\n        \"Choose the result to improve, which cases belong in the total, and your target. Name one thing that must not get worse. Leave the starting measurement unknown if you have not measured it.\",\n        \"Ask AI what your brief leaves unclear or outside the project. Agree those limits with the people involved, or label them as practice assumptions.\"\n      ],\n      \"checks\": [\n        \"The brief defines the outcome, eligible cases and source of its baseline or measurement plan.\",\n        \"In-scope and out-of-scope work are explicit, with one priority tradeoff.\",\n        \"A guardrail and alternative explanations prevent a misleading success claim.\"\n      ]\n    },\n    \"assess\": {\n      \"explain\": \"Explain the baseline, denominator and guardrail in your brief.\",\n      \"locate\": \"Show the decision that limits the first release.\",\n      \"predict\": \"If visits double but missed visits stay constant, what happens to the rate?\",\n      \"compare\": \"Compare logins, completed confirmations and missed visits as success measures.\",\n      \"challenge\": \"AI says the app caused improvement because results improved after release. What else would you investigate?\",\n      \"guide\": \"Change the denominator or remove a source and ask the learner to revise the claim without inventing data.\",\n      \"variations\": [\n        \"The target improves but staff spend an extra hour per day. Reassess success.\",\n        \"The baseline included cancellations; the new count excludes them. Repair the comparison.\"\n      ]\n    },\n    \"reuse\": [7, 22, 26]\n  },\n  {\n    \"id\": 8,\n    \"stage\": 2,\n    \"title\": \"Design the user journey\",\n    \"problem\": \"A receptionist needs to confirm access on a phone while answering calls. A journey designed only for a large screen and a perfect submission will fail in ordinary use.\",\n    \"outcome\": \"An accessible prototype with a tested normal path and a recoverable error path.\",\n    \"foundation\": [\"interfaces\", \"product\", \"quality\"],\n    \"concepts\": [\n      {\n        \"name\": \"Journeys, errors and feedback\",\n        \"explanation\": \"A journey is the sequence from a person's intent to 