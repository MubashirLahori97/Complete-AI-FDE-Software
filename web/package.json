{
  "name": "fde-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-course.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-course.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests *.ts *.json index.html README.md public/*.html ../.github/workflows/*.yml",
    "pretest": "node scripts/prepare-course.mjs",
    "check:course": "node scripts/validate-course.mjs && node scripts/check-course.mjs",
    "check:dom": "node scripts/check-dom-course.mjs",
    "check:kits": "node scripts/check-kits.mjs",
    "check:shop": "node scripts/check-shop-browser.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.7",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  }
}
